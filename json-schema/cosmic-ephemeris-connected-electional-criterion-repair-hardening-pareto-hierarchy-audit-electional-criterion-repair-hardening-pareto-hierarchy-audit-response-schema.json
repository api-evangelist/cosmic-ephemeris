    "HistoricalClock": {
      "type": "string",
      "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9](?::[0-5][0-9])?(?![\\s\\S])",
      "description": "Explicit HH:MM[:SS]; whole seconds only, no leap seconds. Normalized helper output includes seconds."
    },
    "HistoricalDate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "year",
        "era",
        "month",
        "day",
        "calendar"
      ],
      "properties": {
        "year": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2500
        },
        "era": {
          "enum": [
            "BCE",
            "CE"
          ],
          "description": "Display BCE (BC) / CE (AD); API values remain BCE / CE. No year zero."
        },
        "month": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "day": {
          "type": "integer",
          "minimum": 1,
          "maximum": 31
        },
        "calendar": {
          "enum": [
            "proleptic_gregorian",
            "proleptic_julian"
          ],
          "description": "Explicit choice; applies the selected calendar rules throughout history without a regional adoption switch."
        }
      },
      "allOf": [
        {
          "if": {
            "type": "object",
            "properties": {
              "era": {
                "const": "BCE"
              }
            }
          },
          "then": {
            "type": "object",
            "properties": {
              "year": {
                "maximum": 1000
              }
            }
          }
        }
      ],
      "description": "Explicit civil date, 1000 BCE (BC)–2500 CE (AD); no year zero. Calendar validity is checked by the server. Available only on documented connected historical operations, with explicit UT1/fixed-offset conventions."
    },
    "HistoricalDateTime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "date",
        "time",
        "timezone"
      ],
      "properties": {
        "date": {
          "$ref": "#/$defs/HistoricalDate"
        },
        "time": {
          "$ref": "#/$defs/HistoricalClock"
        },
        "timezone": {
          "$ref": "#/$defs/HistoricalTimezone"
        }
      },
      "description": "Shared historical input contract; parsing alone does not enable a calculation route. Derived calculation records can include fractional seconds and are not this input type."
    },
