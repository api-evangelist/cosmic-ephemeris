      "description": "Explicit UT1 or fixed offset UT1+/-HH:MM[:SS], within 14 hours. Local clock minus offset yields UT1, not UTC. No IANA timezone inference. Original offset spelling is preserved."
    },
    "Latitude": {
      "anyOf": [
        {
          "type": "number",
          "exclusiveMinimum": -90,
          "exclusiveMaximum": 90
        },
